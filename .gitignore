# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where third-party dependencies like ExDoc output generated docs.
/doc/

# Ignore .fetch files in case you like to edit your project deps locally.
/.fetch

# If the VM crashes, it generates a dump file, which is also named erl_crash.dump.
erl_crash.dump

# If you run "mix clean --all", it will remove the build artifacts and
# the fetched dependencies directory.
# This file is ignored by git because it is generated by Mix.
/mix.lock

# Temporary files
*.tmp
*.swp
*~

# OS files
.DS_Store
Thumbs.db

